// A code golfed version of tx, 4 PIO cycles per bit

// 0: bit 0
// 1: bit 1
// 3: eop

bit_zero:
    // Assumes input inverted
    mov bits, bits [1]
.wrap
    jmp y-- nostuff [2]
    jmp bit_zero
    set bits, SE0 [7]
    set bits, J [3]
    set pindirs, 0
bit_zero:
.wrap_target
    set y, 5
nostuff:
    out pc, 2
